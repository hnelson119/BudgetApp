{
  "schema_version": 1,
  "policy_id": "household-budget-input-validation-v1",
  "asvs_requirements": [
    "v5.0.0-2.1.1",
    "v5.0.0-2.1.2",
    "v5.0.0-2.1.3",
    "v5.0.0-2.3.2"
  ],
  "last_reviewed": "2026-09-13",
  "next_review_due": "2026-12-12",
  "validation_order": [
    "Decode each transport representation exactly once into its canonical value.",
    "Apply server-side type, syntax, length, range, precision, and allowed-value validation.",
    "Resolve references through active-household or other purpose-scoped querysets.",
    "Validate cross-field, object-state, accounting, recurrence, and lifecycle consistency.",
    "Apply resource and business limits before expensive work or durable state changes.",
    "Repeat security-critical invariants in transactional services and database constraints."
  ],
  "form_registry": [
    {
      "module": "audit.forms",
      "path": "audit/forms.py",
