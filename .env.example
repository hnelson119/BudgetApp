# Non-secret deployment configuration. Production secrets must never be placed
# in this file; Docker Compose mounts them from BUDGET_SECRET_DIR instead.
DJANGO_ALLOWED_HOSTS=budget.example.ts.net
DJANGO_CSRF_TRUSTED_ORIGINS=https://budget.example.ts.net
DJANGO_TIME_ZONE=America/New_York
DJANGO_LOG_LEVEL=INFO
APP_ENVIRONMENT=production
APP_RELEASE=development

# PostgreSQL role names are identities, not passwords.
POSTGRES_DB=household_budget
POSTGRES_ADMIN_USER=budget_admin
POSTGRES_RUNTIME_USER=budget_runtime
POSTGRES_MIGRATION_USER=budget_migration
POSTGRES_BACKUP_USER=budget_backup
POSTGRES_AUDIT_USER=budget_audit
DATABASE_CONN_MAX_AGE=60
CSV_IMPORT_STAGING_RETENTION_HOURS=24

# Absolute directory containing the generated secret files described in README.md.
BUDGET_SECRET_DIR=/etc/household-budget/secrets
# Numeric GID of the root-owned household-budget-secrets group; no human joins it.
BUDGET_SECRET_GID=10002

# Existing off-VM mount. Compose refuses to create it if the mount is absent.
BUDGET_BACKUP_REPOSITORY=/mnt/household-budget-backups
BUDGET_AUDIT_CHECKPOINT_DIRECTORY=/mnt/household-budget-audit-checkpoints
AUDIT_CHECKPOINT_KEY_ID=home-v1
BACKUP_RETENTION_DAILY=7
BACKUP_RETENTION_WEEKLY=4
BACKUP_RETENTION_MONTHLY=12
BUDGET_BACKUP_MAX_AGE_HOURS=36
